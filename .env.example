ALPHA_VANTAGE_API_KEY=your_free_api_key_here

# Optional but REQUIRED for the Earnings Follow-up feature to show real
# results. Free tier at https://finnhub.io/register. Used BEFORE Alpha
# Vantage for the earnings calendar (secondary provider) and company news
# (primary provider) to reduce Alpha Vantage's scarce 25/day quota, and is
# the SOLE provider (not a fallback) for actual reported EPS/revenue in the
# Earnings Follow-up section – nothing else in this codebase has that data.
# Leave empty to skip Finnhub entirely: the calendar/news callers fall back
# to the next provider exactly as if Finnhub were unreachable, but tracked
# earnings will stay "awaiting" forever (eventually "resultsUnavailable"
# after 10 days) since there is no other source for actuals.
FINNHUB_API_KEY=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
# Optional. Hidden recipients (BCC). Multiple addresses separated by commas.
EMAIL_BCC=