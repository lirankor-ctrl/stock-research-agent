ALPHA_VANTAGE_API_KEY=your_free_api_key_here

# Optional. Free tier at https://finnhub.io/register. Used BEFORE Alpha
# Vantage for the earnings calendar (secondary provider) and company news
# (primary provider) to reduce Alpha Vantage's scarce 25/day quota. Leave
# empty to skip Finnhub entirely – every caller falls back to the next
# provider (Nasdaq / Alpha Vantage) exactly as if Finnhub were unreachable.
FINNHUB_API_KEY=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
# Optional. Hidden recipients (BCC). Multiple addresses separated by commas.
EMAIL_BCC=